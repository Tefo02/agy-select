#!/usr/bin/env bash

# Resolve o caminho absoluto deste script para permitir o recarregamento do fzf
SCRIPT_PATH=$(realpath "$0")

# Diretório onde os históricos estão guardados
BRAIN_DIR="$HOME/.gemini/antigravity-cli/brain"

list_conversations() {
    find "$BRAIN_DIR" -name "transcript.jsonl" -printf "%T@ %p\n" |
    sort -rn |
    cut -d' ' -f2- |
    xargs -r -d '\n' jq -R -n -r '
      def clean_text:
        tostring |
        gsub("<(ADDITIONAL_METADATA|USER_SETTINGS_CHANGE|SYSTEM_MESSAGE|USER_INFORMATION|skills|subagents|messaging|conversation_transcript|artifacts|slash_commands|guidelines|communication_style|web_application_development|identity)>[\\s\\S]*?</\\1>"; "") |
        gsub("<[^>]+>"; "") |
        gsub("\\s+"; " ") |
        sub("^\\s+"; "") |
        sub("\\s+$"; "") |
        .[0:100];

      reduce inputs as $line ({};
        (try ($line | fromjson) catch null) as $in |
        if $in and $in.type == "USER_INPUT" then
          if ($in.content | tostring | contains("consolidador de Memória de Longo Prazo") or contains("extrator de memória de longo prazo")) then
            .[input_filename] = "IGNORE_ME"
          else
            if .[input_filename] != "IGNORE_ME" then
              .[input_filename] = ($in.content | clean_text)
            end
          end
        else
          .[input_filename] = (.[input_filename] // null)
        end
      ) |
      to_entries[] |
      select(.value != "IGNORE_ME") |
      "\(.key | split("/") as $parts | ($parts | index(".system_generated")) as $idx | $parts[0:$idx] | join("/"))\t\(.key | split("/") as $parts | ($parts | index(".system_generated")) as $idx | if $idx then $parts[$idx - 1] else $parts[-1] end)\t\(.value // "Sem mensagens")"
    '
}

# Se o primeiro argumento for "list", apenas exibe a listagem das conversas e encerra
if [ "$1" = "list" ]; then
    list_conversations
    exit 0
fi

# Exibe no fzf com preview formatado e atalho para exclusão (CTRL-D) usando whiptail estável com redirecionamento de TTY
selected=$(list_conversations |
    fzf --delimiter=$'\t' \
        --with-nth='2..' \
        --prompt="Selecione uma conversa para continuar > " \
        --header="[ENTER] Continuar | [CTRL-D] Apagar conversa | [ESC] Sair" \
        --bind 'ctrl-d:execute(whiptail --title "Confirmar Exclusão" --yesno "Deseja apagar permanentemente esta conversa?" 0 0 < /dev/tty > /dev/tty && rm -rf "{1}")+reload(bash '"$SCRIPT_PATH"' list)' \
        --preview='jq -R -r '\''
          def clean_preview:
            tostring |
            gsub("<(ADDITIONAL_METADATA|USER_SETTINGS_CHANGE|SYSTEM_MESSAGE|USER_INFORMATION|skills|subagents|messaging|conversation_transcript|artifacts|slash_commands|guidelines|communication_style|web_application_development|identity)>[\\s\\S]*?</\\1>"; "") |
            gsub("<[^>]+>"; "") |
            sub("^\\s+"; "") |
            sub("\\s+$"; "");

          try fromjson catch null |
          select(. != null and (.type == "USER_INPUT" or (.type == "PLANNER_RESPONSE" and .source == "MODEL" and .content != null))) |
          if .type == "USER_INPUT" then
            "👤 User:\n\(.content | clean_preview)\n"
          else
            "🤖 AI:\n\(.content | clean_preview)\n"
          end
        '\'' "{1}/.system_generated/logs/transcript.jsonl" | tail -n 25' \
        --preview-window='right:50%:wrap'
)

# Se o usuário escolher alguma conversa, executa o agy no shell ativo
if [ -n "$selected" ]; then
    cid=$(echo "$selected" | cut -f2)
    agy --conversation "$cid"
fi
